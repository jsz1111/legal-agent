# 环境变量配置
# 应用
APP_NAME=legal-agent
APP_ENV=dev
APP_DEBUG=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=legal
DB_PASSWORD=legal123
DB_NAME=legal_db

# 法律年鉴统计 NL2SQL（与业务库使用同一 PostgreSQL 容器、独立数据库）
LEGAL_STATISTICS_DB_NAME=legal_statistics_db
LEGAL_STATISTICS_DB_USER=legal_statistics_reader
# 留空时复用 DB_PASSWORD；生产环境建议设置独立只读密码
LEGAL_STATISTICS_DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-docs
MINIO_SECURE=false

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19531

# Neo4j
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=legal123

DASHSCOPE_API_KEY=xxxx
# 聊天模型
BASE_URL_CHAT=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-max

DEEPSEEK_API_KEY=xxx
DEEPSEEK_MODEL=deepseek-chat

# MinerU
MINERU_API_URL=http://localhost:8000
MINERU_BACKEND=hybrid-auto-engine
MINERU_TIMEOUT=50

# 日志
LOG_LEVEL=DEBUG
LOG_DIR=logs

# 多模态支持（可选功能）
# 启用后，用户可以上传图片（订单截图、商品照片、聊天记录等），系统自动提取证据信息
ENABLE_MULTIMODAL=false

# 阿里云百炼平台视觉模型配置
# 推荐模型：
#   - qwen3.7-plus：高性能性价比，支持图文视输入（推荐）
#   - qwen3.6-plus：平衡版
#   - qwen3.7-max：最强版，支持文/图/视输入
VL_MODEL=qwen3.7-plus

# 阿里云 API Key（在百炼平台获取）
# 留空则禁用多模态功能，用户只能通过文字对话
VL_API_KEY=

# 图片安全与隐私：默认最大 10 MB / 2400 万像素，处理后删除后端临时副本
MULTIMODAL_MAX_FILE_MB=10
MULTIMODAL_MAX_PIXELS=24000000
MULTIMODAL_TIMEOUT=60
MULTIMODAL_RETAIN_UPLOADS=false
