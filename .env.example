# 环境变量配置
# 应用
APP_NAME=legal-agent
APP_ENV=dev
APP_DEBUG=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=medical
DB_PASSWORD=medical123
DB_NAME=medical_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-docs
MINIO_SECURE=false

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medical123

DASHSCOPE_API_KEY=xxxx
# 聊天模型
BASE_URL_CHAT=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-max

DEEPSEEK_API_KEY=xxx
DEEPSEEK_MODEL=deepseek-chat

# MinerU
MINERU_API_URL=http://localhost:8000
MINERU_BACKEND=hybrid-auto-engine
MINERU_TIMEOUT=50

# 日志
LOG_LEVEL=DEBUG
LOG_DIR=logs

# 多模态支持（可选功能）
# 启用后，用户可以上传图片（订单截图、商品照片、聊天记录等），系统自动提取证据信息
ENABLE_MULTIMODAL=false

# 阿里云百炼平台视觉模型配置
# 可选模型（按价格从低到高）：
#   - qwen-vl-v1：基础版，最便宜，适合简单场景
#   - qwen-vl-plus：平衡版，性价比高（推荐）
#   - qwen-vl-max：最强版，准确度最高但较贵
VL_MODEL=qwen-vl-plus

# 阿里云 API Key（在百炼平台获取）
# 留空则禁用多模态功能，用户只能通过文字对话
VL_API_KEY=
